#include<stdio.h>//SUM OF n numbers using for loop.
int main()
{
    int n, sum=0;
    printf("I am Vaidika acharya Roll no.87\n");
    printf("Enter a range from 0 to n: ");
    scanf("%d",&n);
    for(int i=0;i<=n;i++)
    {
        sum=sum+i;
    
    }
    printf("Sum of numbers from 0 to %d is : %d\n",n,sum);
    return 0;
}
