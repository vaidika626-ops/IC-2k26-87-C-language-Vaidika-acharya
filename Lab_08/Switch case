#include<stdio.h>
int main()
{
    int day;    
    printf("My name is Vaidika acharya \n");
    printf("Roll no:- 87\n");
    printf("Enter day number");
    scanf("%d",&day);
    switch(day)
    {
        case 1:
        printf("monday");
        break;
        case 2:
        printf("Tuesday");
        break;
        case 3:
        printf("Wednesday");
        break;
        case 4:
        printf("Thrusday");
        break;
        case 5:
        printf("Friday");
        break;
        case 6:
        printf("Saturday");
        break;
        case 7:
        printf("Sunday");
        break;
        default:
        printf("Invalid day");
    }
}
