#include<stdio.h>
int main()
{
    int n,count=0;
    printf("I am vaidika acharya \n");
    printf("Roll no:- 87\n");   
    printf("Enter a number");
    scanf("%d",&n);
    printf("Number from 1 to %d divisible by 3 but not by 5\n",n);
    for(int i=1;i<=n;i++)
    {
        if(i%3==0 && i%5!=0)
        {
            printf("%d\n",i);
            count++;
        }
    }
    printf("Total numbers=%d\n",count);
    return 0;
}
