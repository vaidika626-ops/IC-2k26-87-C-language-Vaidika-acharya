#include<stdio.h>
int main()
{
    int n,c,r,arm=0;
    printf("I am vaidika acharya \n");
    printf("Roll no:- 87\n");
    printf("Enter a number");
    scanf("%d",&n);
    c=n;
    while(n>0)
    {
        r=n%10;
        arm=arm+(r*r*r);
        n=n/10;
    }
    if(c==arm)
    
        printf("The number is an Armstrong number\n");
    else
    
        printf("The number is not an Armstrong number\n");
    
    return 0;
}
